    "greenGlow": {
      "$value": "0 0 8px rgba(48, 209, 88, 0.15)",
      "$type": "shadow"
    },
    "greenPillGlow": {
      "$value": "0 2px 8px rgba(48, 209, 88, 0.4)",
      "$type": "shadow"
