    "orangeButton": {
      "$value": "0 4px 14px rgba(255, 159, 10, 0.3)",
      "$type": "shadow"
    },
    "greenButton": {
      "$value": "0 4px 16px rgba(48, 209, 88, 0.3)",
      "$type": "shadow"
    },
    "modal": {
      "$value": "0 20px 50px rgba(0, 0, 0, 0.8)",
      "$type": "shadow"
    }
